#!/bin/sh
# open-debate - CLI: installs /debate in the harnesses and runs the protocol.
set -eu

self="$0"
while [ -L "$self" ]; do
  link="$(readlink "$self")"
  case "$link" in /*) self="$link" ;; *) self="$(dirname -- "$self")/$link" ;; esac
done
ROOT="$(CDPATH= cd -- "$(dirname -- "$self")/.." && pwd)"
TEMPLATE="$ROOT/template"
SKILL="architect-debate"
PKG_SCRIPTS="$TEMPLATE/skills/$SKILL/scripts"
. "$ROOT/lib/harnesses.sh"
. "$ROOT/lib/render.sh"
. "$ROOT/lib/install.sh"

version() { sed -n 's/^[[:space:]]*"version":[[:space:]]*"\([^"]*\)".*/\1/p' "$ROOT/package.json" | head -1; }

usage() {
  cat <<EOF
open-debate $(version) - from an idea to SDD, ADRs, tokens, specs and backlog, through a debate between agents

Install:
  open-debate init [options]                installs in the detected harnesses
  open-debate update [options]              updates, keeping models and edits
  open-debate uninstall [options]           removes what was installed
  open-debate doctor [--live] [options]     checks dependencies, install and, with --live, makes 1 real call
  open-debate harnesses                     lists supported harnesses and the state of each
  open-debate models [check|apply|free]     opencode models
  open-debate models next <case> <agent>    the next model when the agent's runs out of quota (session fallback)
  open-debate models profile <p> [model]    cost profile: free | mixed (strong only on the deciders) | strong
  open-debate upgrade [--check]             downloads the newest stable version and updates the harnesses

  Options: --harness a,b  --all  --project  --force  --yes

Cases:
  open-debate new "<idea>" [dest]           creates the case, default dest=cases
  open-debate run <case> [options]          runs the whole protocol, up to the backlog
  open-debate specs <case> <slug> [slug...] creates specs/<nn>-<slug>/ by hand
  open-debate panel <case> [--save] [a,b]   shows the panel the brief triggers and why
  open-debate status [case]                 shows each phase, the next one, stale outputs and cost; no case lists them all
  open-debate gate <case> <phase> [agent...] runs the gate of 1 phase
  open-debate validate <case> [--brief]     runs every gate of the case
  open-debate backlog <case>                exports CSV, JSON and a gh script
  open-debate handoff <case> [agent]        writes HANDOFF.md to start building; in an opencode session, switches to build
  open-debate tile <case> [source.md]       generates style-tile.html and tokens

  Run options: --harness x  --mix a,b,c  --fallback model,harness:model  --panel design,brand,sec  --rounds 1-3  --from <phase>

Panel: arch, ux and pm always sit. Without --panel, the optional seats come from the brief: design, brand, sec, ai, data,
mobile, gcp, aws, k8s (references/panel.conf).

Input (the idea and the brief answers) can be in any language; every artifact is written in English.
--mix spreads the panel across different harnesses: each one argues with another model.
--fallback lists the models tried, in order, when one runs out of quota; then come the --mix harnesses. The run fails only when none is left.
--from archives that phase and the later ones in raw/archive and redoes them: research agenda proposal critique factcheck rebuttal decision sdd brand specs backlog cards.
Run env: MODEL, MODEL_FALLBACK, HARNESS, HARNESS_CMD, ROUTES, MIX, PANEL, RETRIES, TIMEOUT, BACKOFF, PARALLEL, MAX_CALLS, RESEARCH, AGENDA, FACTCHECK, SPECS, REVIEW (SDD and backlog audits), CARDS, REPAIR, FRESH.
EOF
}

# Updates: install.sh writes "<ref> <sha>" to $ROOT/.open-debate-ref. CI moves the `stable` tag on every push
# to main that passes the tests; the notice compares the local sha with the ref's, once a day, without blocking the command.
REF_FILE="$ROOT/.open-debate-ref"
REPO="DiMarcoSK/open-debate"
sha_remoto() {
  command -v curl >/dev/null 2>&1 || return 1
  curl -fsS -m 3 -H 'Accept: application/vnd.github.sha' "https://api.github.com/repos/$REPO/commits/$1" 2>/dev/null
}
news() { # prints the message and returns 0 when there is a new version
  [ -f "$REF_FILE" ] || return 1
  read -r ref sha < "$REF_FILE" || return 1
  r="$(sha_remoto "$ref")" || return 1
  [ -n "$r" ] && [ "$r" != "$sha" ] || return 1
  printf 'open-debate: new version on %s (%s), run: open-debate upgrade\n' "$ref" "$(printf '%s' "$r" | cut -c1-7)"
}
daily_notice() {
  [ -f "$REF_FILE" ] && [ -z "${OPEN_DEBATE_NO_UPDATE_CHECK:-}" ] && [ -t 2 ] || return 0
  mark="$ROOT/.open-debate-check"
  [ -z "$(find "$mark" -mtime -1 2>/dev/null)" ] || return 0
  : > "$mark" 2>/dev/null || return 0
  news >&2 || true
}
cmd_upgrade() {
  if [ ! -f "$REF_FILE" ]; then
    echo "error: installed without install.sh; update the way you installed (npm update -g open-debate or git pull) and run: open-debate update" >&2; exit 2
  fi
  if [ "${1:-}" = "--check" ]; then news || echo "open-debate $(version) is up to date"; return 0; fi
  read -r ref sha < "$REF_FILE"
  # Copy the installer: it replaces the whole $ROOT while it runs.
  t="$(mktemp)"; cp "$ROOT/install.sh" "$t"
  OPEN_DEBATE_HOME="$ROOT" OPEN_DEBATE_REF="$ref" sh "$t"; rc=$?
  rm -f "$t"; return "$rc"
}

run_script() {
  s="$1"; shift
  exec "$PKG_SCRIPTS/$s" "$@"
}

need_args() {
  [ "$1" -ge "$2" ] || { usage >&2; exit 2; }
}

csv() { printf '%s' "$1" | tr ',' ' '; }

installed() {
  for h in $HARNESSES; do resolve_target "$h"; if [ -f "$MANIFEST" ]; then printf '%s ' "$h"; fi; done
}

# targets <command>: the harnesses the command acts on.
targets() {
  if [ "$ALL" = "1" ]; then printf '%s' "$HARNESSES"; return; fi
  if [ -n "$CHOICE" ]; then printf '%s' "$CHOICE"; return; fi
  case "$1" in
    init) detected_list ;;
    doctor) printf '%s' "$HARNESSES" ;;
    *) installed ;;
  esac
}

confirm() {
  [ "$YES" = "0" ] && [ -t 0 ] && [ -z "$CHOICE" ] && [ "$ALL" = "0" ] || return 0
  printf 'Install in: %s? [Y/n] ' "$1"
  read -r r || r=""
  case "$r" in n*|N*) echo "cancelled; pick with --harness a,b"; exit 1 ;; esac
}

each() {
  cmd="$1"; list="$2"; rc=0; agents_dir=""
  for h in $list; do
    # In a project, codex and agy read the same .agents/skills: only 1 /debate entry fits there.
    if [ "$PROJECT" = "1" ] && [ "$cmd" != "uninstall" ]; then
      case "$h" in
        codex|agy)
          if [ -n "$agents_dir" ]; then
            echo "warning: $h and $agents_dir share .agents/skills in the project, kept the entry of $agents_dir; $h is still available through: open-debate run --harness $h"
            continue
          fi
          agents_dir="$h" ;;
      esac
    fi
    resolve_target "$h"
    case "$cmd" in
      init|update) do_install "$cmd" || rc=$? ;;
      uninstall) do_uninstall || rc=$? ;;
    esac
  done
  return "$rc"
}

default_run() {
  for h in claude codex gemini agy omp droid cursor copilot qwen dsh pi cline opencode; do
    h_load "$h"
    if h_bin >/dev/null; then printf '%s' "$h"; return 0; fi
  done
  return 1
}

cmd_run() {
  case_dir=""; rounds=""
  while [ "$#" -gt 0 ]; do
    case "$1" in
      --harness) HARNESS="$2"; shift 2 ;;
      --mix) MIX="$(csv "$2")"; shift 2 ;;
      --fallback) MODEL_FALLBACK="$(csv "$2")"; export MODEL_FALLBACK; shift 2 ;;
      --rounds) rounds="$2"; shift 2 ;;
      --from) FROM="$2"; export FROM; shift 2 ;;
      --panel) PANEL=""; for a in $(csv "$2"); do PANEL="$PANEL debate-${a#debate-}"; done; PANEL="${PANEL# }"; shift 2 ;;
      -*) echo "error: unknown option: $1" >&2; exit 2 ;;
      *) if [ -z "$case_dir" ]; then case_dir="$1"; else rounds="$1"; fi; shift ;;
    esac
  done
  [ -n "$case_dir" ] || { usage >&2; exit 2; }
  if [ -z "${HARNESS:-}" ]; then
    HARNESS="$(sed -n 's/^harness: //p' "$case_dir/meta.txt" 2>/dev/null | tail -1)"
    [ -n "$HARNESS" ] || HARNESS="$(default_run)" || { echo "error: no harness found on PATH (see: open-debate harnesses)" >&2; exit 2; }
  fi
  export HARNESS MIX="${MIX:-}"
  [ -z "${PANEL:-}" ] || export PANEL
  if [ "$HARNESS" = "opencode" ]; then
    PROJECT=0; resolve_target opencode
    if [ ! -f "$MANIFEST" ] && [ ! -f "$TARGET/agents/debate-judge.md" ]; then
      PROJECT=1; resolve_target opencode
    fi
    [ -f "$TARGET/agents/debate-judge.md" ] || { echo "error: debate agents not installed, run: open-debate init" >&2; exit 2; }
  fi
  if [ -n "$rounds" ]; then run_script debate.sh "$case_dir" "$rounds"; else run_script debate.sh "$case_dir"; fi
}

cmd="${1:-help}"
[ "$#" -eq 0 ] || shift
case "$cmd" in -h|--help|help|-v|--version|version|upgrade) ;; *) daily_notice ;; esac
case "$cmd" in
  upgrade) cmd_upgrade "$@" ;;
  -h|--help|help) usage ;;
  -v|--version|version) version ;;
  init|update|uninstall|doctor|models|harnesses)
    PROJECT=0; FORCE=0; ARG=""; ALL=0; YES=0; CHOICE=""; LIVE=0
    while [ "$#" -gt 0 ]; do
      case "$1" in
        --project) PROJECT=1 ;;
        --force) FORCE=1 ;;
        --all) ALL=1 ;;
        --yes|-y) YES=1 ;;
        --live) LIVE=1 ;;
        --harness) [ "$#" -ge 2 ] || { echo "error: --harness needs a list" >&2; exit 2; }; CHOICE="$(csv "$2")"; shift ;;
        --harness=*) CHOICE="$(csv "${1#--harness=}")" ;;
        -*) echo "error: unknown option: $1" >&2; exit 2 ;;
        *) ARG="${ARG:+$ARG }$1" ;;
      esac
      shift
    done
    list="$(targets "$cmd")"
    case "$cmd" in
      init)
        if [ -z "$list" ]; then
          echo "error: no harness detected. Install one or pick with --harness a,b. Supported: $HARNESSES" >&2; exit 2
        fi
        confirm "$list"; each init "$list" ;;
      update|uninstall)
        [ -n "$list" ] || { echo "error: nothing installed, run: open-debate init" >&2; exit 2; }
        each "$cmd" "$list" ;;
      doctor)
        rc=0; do_doctor "$list" || rc=$?
        if [ "$LIVE" = "1" ]; then
          for h in $(installed); do h_load "$h"; if h_bin >/dev/null; then "$PKG_SCRIPTS/probe.sh" "$h" || rc=1; fi; done
        fi
        exit "$rc" ;;
      models) do_models ${ARG:-check} ;;
      harnesses) do_harnesses ;;
    esac ;;
  new) need_args "$#" 1; run_script new-debate.sh "$@" ;;
  run) need_args "$#" 1; cmd_run "$@" ;;
  specs) need_args "$#" 2; run_script make-specs.sh "$@" ;;
  status)
    # Without a case: 1 line per case under ./cases with its next phase.
    if [ "$#" -eq 0 ]; then
      n=0
      for c in cases/*/; do
        [ -f "${c}brief.md" ] || continue
        n=$((n + 1)); printf '%-40s %s\n' "${c%/}" "$("$PKG_SCRIPTS/status.sh" "${c%/}" 2>/dev/null | sed -n 's/^next: //p')"
      done
      [ "$n" -gt 0 ] || { echo "no case under ./cases; create one with: open-debate new \"<idea>\"" >&2; exit 2; }
    else run_script status.sh "$@"; fi ;;
  panel) need_args "$#" 1; c="$1"; shift; run_script panel.sh "$c" $(for x in "$@"; do csv "$x"; printf ' '; done) ;;
  gate) need_args "$#" 2; run_script gate.sh "$@" ;;
  validate) need_args "$#" 1; run_script validate.sh "$@" ;;
  backlog) need_args "$#" 1; run_script backlog-export.sh "$@" ;;
  handoff) need_args "$#" 1; run_script handoff.sh "$@" ;;
  tile) need_args "$#" 1; run_script style-tile.sh "$@" ;;
  *) echo "error: unknown command: $cmd" >&2; usage >&2; exit 2 ;;
esac
