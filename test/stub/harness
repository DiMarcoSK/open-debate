#!/bin/sh
# Stub dos harnesses: o nome do link escolhe o formato de saida real daquele CLI. Sem rede e sem LLM.
set -eu
self="$0"
# So builtins onde da: cada processo a menos conta, o stub roda em toda chamada simulada da suite.
real="$self"; [ ! -L "$self" ] || real="$(readlink "$self")"
case "$real" in /*) ;; *) real="${self%/*}/$real" ;; esac
FX="${real%/*}/../fixtures"
nome="${self##*/}"; [ "$nome" != "harness" ] || { nome="$1"; shift; }
[ -z "${STUB_LOG:-}" ] || { l_="$(printf '%s' "$*" | tr '\n' ' ')"; printf '%s %.2000s\n' "$nome" "$l_" >> "$STUB_LOG"; }
fim=""; p=""
while [ "$#" -gt 0 ]; do
  case "$1" in -o) if [ "$nome" = "codex" ]; then fim="$2"; fi ;; esac
  case "$1" in *"## Tarefa"*|"Responda"*) p="$1" ;; esac
  shift
done
# Tarefa: 1a linha nao vazia depois de "## Tarefa". Papel: 1a linha "You are the ..." da persona.
tarefa=""; agente=""; depois=0
while IFS= read -r l; do
  case "$l" in "You are the "*) [ -n "$agente" ] || agente="$l" ;; esac
  if [ "$depois" = 1 ] && [ -n "$l" ] && [ -z "$tarefa" ]; then tarefa="$l"; fi
  case "$l" in "## Tarefa"*) depois=1 ;; esac
done <<EOF_P
$p
EOF_P
[ -n "$tarefa" ] || tarefa="$p"
case "$agente" in
  *"software product designer"*) short=design ;; *"UI and UX"*) short=ux ;; *"creative director"*) short=brand ;;
  *"head of product"*) short=pm ;; *Kubernetes*) short=k8s ;; *security*) short=sec ;; *"GCP "*) short=gcp ;;
  *"AWS "*) short=aws ;; *"data and analytics"*) short=data ;; *"AI engineer"*) short=ai ;; *mobile*) short=mobile ;;
  *) short=arch ;;
esac
case "$tarefa" in
  "modo pesquisa"*) f=research.md ;;
  "modo fact-check"*) f=research-check.md ;;
  "fase agenda"*) f=agenda.md ;;
  "fase proposta"*) f="proposta-$short.md" ;;
  "fase ataque"*) f=ataque.md; [ "$short" = "ux" ] && f=ataque-ux.md ;;
  "fase replica"*) f=replica.md ;;
  "fase decisao"*) f=decision.md ;;
  "fase sdd"*|"fase correcao"*) f=SDD.md ;;
  "fase marca"*) f=BRANDBOOK.md ;;
  "fase auditoria"*) f="${STUB_AUDITORIA:-auditoria.md}" ;;
  "fase spec"*) f=spec-bundle.md ;;
  "fase backlog-design"*|"fase backlog-eng"*) f=trilha.md ;;
  "fase backlog"*) f=BACKLOG.md ;;
  *"PRONTO"*) f="" ;;
  *) echo "stub: tarefa desconhecida: $tarefa" >&2; exit 2 ;;
esac
if [ -z "$f" ]; then texto=PRONTO
elif [ "${FAIL_ONCE:-}" = "$f" ] && [ ! -e "$STUB_STATE.$f" ]; then
  : > "$STUB_STATE.$f"; texto="$(printf 'sem nada util\nlinha\nlinha\nlinha\nlinha\nlinha')"
else
  texto="$(cat "$FX/$f")"
  # Ataque de verdade mira um rival do painel: o nome sai da propria tarefa.
  if [ "$f" = "ataque.md" ] || [ "$f" = "ataque-ux.md" ]; then
    r_="${tarefa#*proposals/debate-}"; rival="debate-${r_%%[!a-z0-9]*}"
    texto="$(printf '%s\n' "$texto" | sed "s/debate-gcp/$rival/g")"
  fi
fi
case "$nome" in
  claude|cursor-agent|droid) printf '%s' "$texto" | jq -Rs '{type:"result",is_error:false,result:.}' -c ;;
  gemini|agy) printf '%s' "$texto" | jq -Rs '{response:.,stats:{}}' -c ;;
  qwen) printf '%s' "$texto" | jq -Rs '[{type:"system"},{type:"result",result:.}]' -c ;;
  codex) printf '%s\n' "$texto" > "$fim"; echo "progresso que nao e resposta" ;;
  *) printf '%s\n' "$texto" ;;
esac
