#!/bin/sh
# Harness stub: the link name picks that CLI's real output format. No network and no LLM.
set -eu
self="$0"
# Builtins where possible: every process saved counts, the stub runs on every simulated call of the suite.
real="$self"; [ ! -L "$self" ] || real="$(readlink "$self")"
case "$real" in /*) ;; *) real="${self%/*}/$real" ;; esac
FX="${real%/*}/../fixtures"
nome="${self##*/}"; [ "$nome" != "harness" ] || { nome="$1"; shift; }
[ -z "${STUB_LOG:-}" ] || { l_="$(printf '%s' "$*" | tr '\n' ' ')"; printf '%s %.2000s\n' "$nome" "$l_" >> "$STUB_LOG"; }
fim=""; p=""
while [ "$#" -gt 0 ]; do
  case "$1" in -o) if [ "$nome" = "codex" ]; then fim="$2"; fi ;; esac
  case "$1" in *"## Task"*|"Reply with"*) p="$1" ;; esac
  shift
done
# Task: 1st non-empty line after "## Task". Role: the persona's 1st "You are the ..." line.
tarefa=""; agente=""; depois=0
while IFS= read -r l; do
  case "$l" in "You are the "*) [ -n "$agente" ] || agente="$l" ;; esac
  if [ "$depois" = 1 ] && [ -n "$l" ] && [ -z "$tarefa" ]; then tarefa="$l"; fi
  case "$l" in "## Task"*) depois=1 ;; esac
done <<EOF_P
$p
EOF_P
[ -n "$tarefa" ] || tarefa="$p"
case "$agente" in
  *"software product designer"*) short=design ;; *"UI and UX"*) short=ux ;; *"creative director"*) short=brand ;;
  *"head of product"*) short=pm ;; *Kubernetes*) short=k8s ;; *security*) short=sec ;; *"GCP "*) short=gcp ;;
  *"AWS "*) short=aws ;; *"data and analytics"*) short=data ;; *"AI engineer"*) short=ai ;; *mobile*) short=mobile ;;
  *) short=arch ;;
esac
case "$tarefa" in
  "phase research"*) f=research.md ;;
  "phase fact-check"*) f=research-check.md ;;
  "phase agenda"*) f=agenda.md ;;
  "phase proposal"*) f="proposal-$short.md" ;;
  "phase critique"*) f=critique.md; [ "$short" = "ux" ] && f=critique-ux.md ;;
  "phase rebuttal"*) f=rebuttal.md ;;
  "phase decision"*) f=decision.md ;;
  "phase sdd"*|"phase fix"*) f=SDD.md ;;
  "phase brand"*) f=BRANDBOOK.md ;;
  "phase audit"*) f="${STUB_AUDIT:-audit.md}" ;;
  "phase spec"*) f=spec-bundle.md ;;
  "phase backlog-audit"*) f="${STUB_BACKLOG_AUDIT:-backlog-audit.md}" ;;
  "phase backlog-fix"*) f=BACKLOG.md ;;
  "phase cards"*) f=cards.md ;;
  "phase backlog-design"*|"phase backlog-eng"*) f=track.md ;;
  "phase backlog"*) f=BACKLOG.md ;;
  *"READY"*) f="" ;;
  *) echo "stub: unknown task: $tarefa" >&2; exit 2 ;;
esac
if [ -z "$f" ]; then texto=READY
elif [ "${FAIL_ONCE:-}" = "$f" ] && [ ! -e "$STUB_STATE.$f" ]; then
  : > "$STUB_STATE.$f"; texto="$(printf 'nothing useful\nline\nline\nline\nline\nline')"
else
  texto="$(cat "$FX/$f")"
  # A real critique targets a panel rival: the name comes from the task itself.
  if [ "$f" = "critique.md" ] || [ "$f" = "critique-ux.md" ]; then
    r_="${tarefa#*proposals/debate-}"; rival="debate-${r_%%[!a-z0-9]*}"
    texto="$(printf '%s\n' "$texto" | sed "s/debate-gcp/$rival/g")"
  fi
fi
case "$nome" in
  claude|cursor-agent|droid) printf '%s' "$texto" | jq -Rs '{type:"result",is_error:false,result:.,usage:{input_tokens:900,cache_read_input_tokens:0,output_tokens:100}}' -c ;;
  gemini|agy) printf '%s' "$texto" | jq -Rs '{response:.,stats:{}}' -c ;;
  qwen) printf '%s' "$texto" | jq -Rs '[{type:"system"},{type:"result",result:.}]' -c ;;
  codex) printf '%s\n' "$texto" > "$fim"; echo "progress that is not the answer" ;;
  *) printf '%s\n' "$texto" ;;
esac
