#!/bin/sh
# opencode stub for the tests: no network and no LLM. `run` returns the phase fixture in opencode's JSON.
set -eu
FX="$(CDPATH= cd -- "$(dirname -- "$0")/../fixtures" && pwd)"
[ -z "${STUB_LOG:-}" ] || printf '%s\n' "$*" >> "$STUB_LOG"

if [ "${1:-}" = "models" ]; then
  printf 'opencode/free-a\n{"id":"free-a","providerID":"opencode","status":"active","cost":{"input":0,"output":0},"capabilities":{"toolcall":true}}\n'
  printf 'opencode/free-b\n{"id":"free-b","providerID":"opencode","status":"active","cost":{"input":0,"output":0},"capabilities":{"toolcall":true}}\n'
  printf 'opencode/paid\n{"id":"paid","providerID":"opencode","status":"active","cost":{"input":1,"output":2},"capabilities":{"toolcall":true}}\n'
  exit 0
fi

[ "${1:-}" = "run" ] || { echo "stub: unsupported command: $*" >&2; exit 2; }
agent=""; task=""
while [ "$#" -gt 0 ]; do
  case "$1" in
    --agent) agent="$2"; shift 2 ;;
    --format|--dir|-m|--log-level) shift 2 ;;
    run|--print-logs) shift ;;
    *) task="$1"; shift ;;
  esac
done

short="${agent#debate-}"
case "$task" in
  "phase research"*) f=research.md ;;
  "phase fact-check"*) f=research-check.md ;;
  "phase agenda"*) f=agenda.md ;;
  "phase proposal"*) f="proposal-$short.md" ;;
  "phase critique"*) f=critique.md; [ "$short" = "ux" ] && f=critique-ux.md ;;
  "phase rebuttal"*) f=rebuttal.md ;;
  "phase decision"*) f=decision.md ;;
  "phase sdd"*|"phase fix"*) f=SDD.md ;;
  "phase brand"*) f=BRANDBOOK.md ;;
  "phase audit"*) f="${STUB_AUDIT:-audit.md}" ;;
  "phase spec"*) f=spec-bundle.md ;;
  "phase backlog-audit"*) f="${STUB_BACKLOG_AUDIT:-backlog-audit.md}" ;;
  "phase backlog-fix"*) f=BACKLOG.md ;;
  "phase cards"*) f=cards.md ;;
  "phase backlog-design"*|"phase backlog-eng"*) f=track.md ;;
  "phase backlog"*) f=BACKLOG.md ;;
  *) echo "stub: unknown task: $task" >&2; exit 2 ;;
esac

# FAIL_ONCE=<fixture>: the 1st call returns a failing output, to exercise the gate repair
if [ "${FAIL_ONCE:-}" = "$f" ] && [ ! -e "$STUB_STATE.$f" ]; then
  : > "$STUB_STATE.$f"
  printf 'nothing useful\nline\nline\nline\nline\nline\n' | jq -Rs '{type:"text",part:{text:.}}' -c
  exit 0
fi
rival="$(printf '%s' "$task" | grep -Eo 'proposals/debate-[a-z0-9]+' | head -1 | sed 's#proposals/##')"
if [ "$f" = "critique.md" ] || [ "$f" = "critique-ux.md" ]; then sed "s/debate-gcp/$rival/g" "$FX/$f"; else cat "$FX/$f"; fi | jq -Rs '{type:"text",part:{text:.}}' -c
echo '{"type":"step_finish","part":{"tokens":{"input":900,"output":100,"reasoning":0,"cache":{"read":0,"write":0}}}}'
